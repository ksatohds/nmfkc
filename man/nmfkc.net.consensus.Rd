P <- ifelse(outer(g, g, "=="), 0.8, 0.05)
Y <- matrix(rbinom(length(P), 1, P), nrow(P))
Y[lower.tri(Y)] <- t(Y)[lower.tri(Y)]; diag(Y) <- 0
cs <- nmfkc.net.consensus(Y, rank = 2:6, nrun = 20, keep.consensus = TRUE)
cs                                    # the most stable rank is 3
plot(cs)
